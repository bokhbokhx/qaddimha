# انسخ هذا الملف إلى .env ولا ترفع .env إلى git.

# قاعدة البيانات (PostgreSQL)
DATABASE_URL="postgresql://qaddimha:qaddimha_dev@localhost:5432/qaddimha"

# development | production — في الإنتاج: يُمنع الدفع المحاكى والحسابات التجريبية ويُفعّل Secure للكعكات
APP_ENV="development"

# مجلد التخزين الخاص للملفات (خارج public). في الإنتاج استبدله بتخزين مُدار.
STORAGE_DIR="./storage"

# مزود الذكاء الاصطناعي: اتركه فارغًا ليعمل الوضع التجريبي تلقائيًا عند غياب المفتاح
# AI_PROVIDER="anthropic"   # أو demo
ANTHROPIC_API_KEY=""
# معرف النموذج إعداد وليس ثابتًا في الكود — راجع توثيق Anthropic الحالي
AI_MODEL=""
AI_TIMEOUT_MS="90000"
AI_MAX_RETRIES="2"
AI_MAX_INPUT_CHARS="120000"
AI_MAX_OUTPUT_TOKENS="16000"

# الدفع: simulated متاح خارج الإنتاج فقط. لا يوجد مزود حقيقي مفعّل في هذه النسخة.
PAYMENTS_MODE="simulated"

# أسعار تجريبية بالهللة (اختياري)
# PRICE_PACKAGE_HALALAS="149000"
# PRICE_REVIEW_HALALAS="90000"

# مسار Chromium لتوليد PDF (اختياري؛ يُستخدم متصفح Playwright المثبت افتراضيًا)
# CHROMIUM_PATH=""

# حد محاولات الدخول لكل 10 دقائق (افتراضي 10)
# LOGIN_RATE_LIMIT="10"
